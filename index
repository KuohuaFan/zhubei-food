/* ================= 卡片 ================= */
function renderGrid(cat='all'){
  const g=$('grid');g.innerHTML='';
  SHOPS.filter(s=>cat==='all'||s.cats.includes(cat)).forEach(s=>{
    const el=document.createElement('div');el.className='card';
    const links=s.links.map(([t,u])=>`<a class="card-link" href="${u}" target="_blank" rel="noopener">${t} ↗</a>`).join('');
    el.innerHTML=`
      <div class="card-top"><span class="tag">${s.tag}</span><span class="badge ${s.badgeCls}">${s.badge}</span></div>
      <h3>${s.name}</h3>
      <p>${s.desc}</p>
      <p class="rec">${s.rec}</p>
      <div class="info-row"><span>📍 ${s.area}</span><span>💰 ${s.price}</span></div>
      <div class="meta">
        <span class="links">${links}</span>
        <button class="star-btn ${starred.has(s.id)?'on':''}" data-star="${s.id}" aria-label="加入星號">★</button>
      </div>`;
    g.appendChild(el);
  });
}
renderGrid();

document.addEventListener('click',e=>{
  const sb=e.target.closest('[data-star]');
  if(sb){
    const id=+sb.dataset.star;
    starred.has(id)?starred.delete(id):starred.add(id);
    sb.classList.toggle('on');
    $('starCount').textContent=starred.size;
    renderStarList();
  }
});
function renderStarList(){
  const ul=$('starList');ul.innerHTML='';
  if(!starred.size){ul.innerHTML='<li class="empty">還沒有星號店家。回首頁，在卡片右下角點 ★ 收藏。</li>';return;}
  [...starred].map(id=>SHOPS.find(s=>s.id===id)).forEach(s=>{
    const li=document.createElement('li');
    li.innerHTML=`<b>${s.name}</b><span>${s.tag}・${s.badge}・${s.price}</span><small>${s.area}</small>`;
    ul.appendChild(li);
  });
}
renderStarList();

