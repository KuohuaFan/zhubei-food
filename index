/* ================= 沈浸式對話 ================= */
const SYSTEM_PROMPT=`你是「食通」，台灣新竹縣竹北市的在地美食嚮導。
已查證的在地事實（2026年8月）：
- 鮨安 Sushi An：竹北高鐵特區嘉豐南路一段，2026年獲新竹縣史上第一顆米其林一星，主廚許劉安另獲年輕主廚大獎；江戶前無菜單壽司，一場僅六席，需預約。
- 季風 Monsoon：2026 米其林必比登推介，新客家蔬食，完全預約制。
- 善菓堂：竹北創意蔬食，必比登推介。
- 彼刻義式餐酒館：義大利紅蝦評鑑二蝦，約千元/人。
- 托斯卡尼尼義大利庭園餐廳（六家，約750/人）、紅倉庫歐陸廚房（西班牙菜，文興路，約700/人）、橋下2.0餐酒館（莊敬北路，約700/人）、馬友友印度廚房（光明一路，北印料理）、段純貞牛肉麵（發跡竹北）、十一街麵食館（眷村麵食）。
規則：
1. 一律使用台灣繁體中文，語氣像熟門熟路的在地朋友，親切但不油。
2. 優先引用上述已查證店家；其他店家可談但要註明資訊可能過時。
3. 給建議時說明「為什麼」：口味、價位帶、適合的場合與人數。
4. 不確定的營業資訊要坦白說不確定，提醒以店家公告為準；不要編造地址與電話。
5. 回答保持精煉：一般問題 150 字內，行程規劃可長一些，用短段落。`;

function addTurn(role,text,thinking=false){
  const doc=$('chatDoc');
  const div=document.createElement('div');
  div.className='turn '+(role==='user'?'user':'ai');
  div.innerHTML=`<div class="who">${role==='user'?'你':'食 通'}</div>
    <div class="text">${thinking?'<div class="thinking"><i></i><i></i><i></i></div>':escapeHtml(text)}</div>`;
  doc.appendChild(div);
  $('chatScroll').scrollTop=$('chatScroll').scrollHeight;
  return div;
}
function escapeHtml(s){return s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}

/* ---- API Key（僅存於記憶體，重新整理即清除） ---- */
let apiKey='';
$('keyBtn').addEventListener('click',()=>$('keyRow').classList.toggle('show'));
$('keySave').addEventListener('click',()=>{
  apiKey=$('keyInput').value.trim();
  $('modeBadge').textContent=apiKey?'竹北美食嚮導・AI 已連線':'竹北美食嚮導・示範模式';
  $('keyRow').classList.remove('show');
});
$('keyClear').addEventListener('click',()=>{
  apiKey='';$('keyInput').value='';
  $('modeBadge').textContent='竹北美食嚮導・示範模式';
});

/* ---- 內建示範回覆（無 API Key 時使用） ---- */
function localAnswer(q){
  const rules=[
    [/米其林|摘星|必比登/, '竹北在 2026 年正式摘下新竹縣第一顆米其林星：「鮨安」的江戶前無菜單壽司（高鐵特區，一場僅六席，務必提早預約）。必比登推介則有新客家蔬食「季風 Monsoon」與創意蔬食「善菓堂」，都是預約制或熱門店，建議先訂位。'],
    [/客家|蔬食|素/, '想吃客家與蔬食路線，首選必比登推介的「季風 Monsoon」——客家主廚用蔬食重新詮釋經典客家菜，完全預約制；「善菓堂」則適合宴客與長輩聚餐，環境精緻。'],
    [/義大利|義式|披薩|燉飯/, '義式兩條路線：家庭聚餐選「托斯卡尼尼」（六家高鐵旁歐風獨棟，約750/人）；約會紀念日選「彼刻義式餐酒館」（紅蝦評鑑二蝦，自製麵條，約千元/人，走精緻限量路線）。'],
    [/西班牙|地中海|海鮮飯/, '西班牙菜代表是文興路的「紅倉庫歐陸廚房」，挑高空間適合多人分食海鮮飯，約700/人，週一公休。想配酒聊晚一點可考慮莊敬北路的「橋下2.0」餐酒館。'],
    [/印度|咖哩|烤餅/, '印度料理找光明一路的「馬友友印度廚房」：現烤北印烤餅蘸咖哩、炭火 Tandoori 烤雞，適合多人分食，約400–700/人。'],
    [/牛肉麵|中式|麵/, '「段純貞牛肉麵」發跡於竹北，川味紅燒湯頭麻香厚實，是認識竹北味的第一碗；眷村口味則到「十一街麵食館」吃炸醬麵配小米粥，尖峰時段常客滿。'],
    [/約會|紀念日|求婚/, '約會建議「彼刻義式餐酒館」（紅蝦評鑑、氣氛佳）或直上「鮨安」壽司（米其林一星，六席板前，儀式感滿分但要搶位）。'],
    [/小孩|親子|家庭|長輩/, '家庭聚餐首選「托斯卡尼尼」義大利庭園餐廳，空間大、菜色接受度高；長輩偏好清淡可選「善菓堂」蔬食。'],
    [/路線|半日|行程/, '半日吃貨路線：中午十一街麵食館眷村麵 → 下午光明商圈散步 → 晚餐依預算二選一：紅倉庫西班牙菜（聚餐）或彼刻義式（約會）。想衝米其林請提早數週訂鮨安。'],
  ];
  for(const [re,ans] of rules){ if(re.test(q)) return ans; }
  return '這題我先給通用建議：跟我說人數、預算與口味偏好（米其林／中式／義式／西班牙／印度／蔬食），我可以更精準。若要即時 AI 回覆，請點右上角「API Key」連線 Claude。';
}

async function callClaude(){
  const body={model:'claude-sonnet-4-6',max_tokens:1000,system:SYSTEM_PROMPT,messages:chatHistory};
  /* 第一段：免金鑰直連（在 Claude.ai 預覽環境中由平台代理，可直接使用） */
  try{
    const r=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const d=await r.json();
    if(!d.error&&d.content){$('modeBadge').textContent='竹北美食嚮導・AI 已連線';return d;}
  }catch(e){/* 進入第二段 */}
  /* 第二段：使用者提供的 API Key（GitHub Pages 等外部部署環境） */
  if(apiKey){
    const r=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json','x-api-key':apiKey,
        'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
      body:JSON.stringify(body)});
    const d=await r.json();
    if(d.error)throw new Error(d.error.message||'API error');
    return d;
  }
  return null; /* 第三段：呼叫端退回示範回覆 */
}

async function send(text){
  if(!text.trim())return;
  addTurn('user',text);
  chatHistory.push({role:'user',content:text});
  const pending=addTurn('ai','',true);
  $('sendBtn').disabled=true;
  try{
    const data=await callClaude();
    if(data){
      const reply=(data.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('\n').trim()
        ||'（暫時沒有回應，再試一次看看。）';
      pending.querySelector('.text').textContent=reply;
      chatHistory.push({role:'assistant',content:reply});
    }else{
      /* 示範模式：本地規則回覆 */
      await new Promise(r=>setTimeout(r,400));
      const reply=localAnswer(text);
      pending.querySelector('.text').textContent=reply;
      chatHistory.push({role:'assistant',content:reply});
    }
  }catch(err){
    pending.querySelector('.text').textContent='連線失敗：'+(err.message||'請稍後再試')+'。請確認 API Key 是否有效，或直接再送一次改用示範回覆。';
    chatHistory.pop(); /* 移除失敗的這輪 user 訊息以便重送 */
  }
  $('sendBtn').disabled=false;
  $('chatScroll').scrollTop=$('chatScroll').scrollHeight;
}

$('chatFab').addEventListener('click',()=>{$('chatLayer').classList.add('open');$('chatText').focus()});
$('chatClose').addEventListener('click',()=>$('chatLayer').classList.remove('open'));
$('sendBtn').addEventListener('click',()=>{const t=$('chatText').value;$('chatText').value='';autoGrow();send(t)});
$('chatText').addEventListener('keydown',e=>{
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();const t=e.target.value;e.target.value='';autoGrow();send(t)}
});
function autoGrow(){const t=$('chatText');t.style.height='auto';t.style.height=Math.min(t.scrollHeight,130)+'px'}
$('chatText').addEventListener('input',autoGrow);

