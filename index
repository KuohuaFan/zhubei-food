    <p class="sub" style="margin-top:26px;margin-bottom:8px"><b>延伸閱讀</b></p>
    <p>${p.refs.map(([t,u])=>`<a class="card-link" href="${u}" target="_blank" rel="noopener">${t} ↗</a>`).join(' ')}</p>
    <button class="new-chat" data-proj-chat="${i}" style="margin-top:26px;background:var(--indigo);border-color:var(--indigo);max-width:320px">
      💬 和食通聊「${p.title}」
    </button>`;
  showView('projects',false);
}
